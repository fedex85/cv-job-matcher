# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.

# --- Aplicación ---
APP_ENV=development            # development | production
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
ENABLE_UI=true                 # sirve la interfaz web en /app
ENABLE_GRADIO=false            # interfaz antigua de Gradio en /ui (opcional)
# Orígenes permitidos por CORS, separados por comas ("" = ninguno)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Si se define, la API exige la cabecera X-API-Key (recomendado en producción)
API_KEY=

# --- Historial de ofertas vistas (solo guarda la OFERTA, nunca el CV) ---
HISTORY_ENABLED=true
HISTORY_DB_PATH=               # vacío = data/processed/history.db
HISTORY_MAX_ENTRIES=2000

# --- Límites de seguridad ---
MAX_UPLOAD_MB=5
MAX_PDF_PAGES=15
MAX_TEXT_CHARS=60000
MAX_JOB_CHARS=20000
RATE_LIMIT_PER_MINUTE=20

# --- LLM (Groq, opcional: sin clave se usan consejos basados en reglas) ---
LLM_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30

# --- Similitud semántica ---
# tfidf (sin descargas) | sentence-transformers (requiere requirements-ml.txt)
EMBEDDING_BACKEND=tfidf
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# --- Ponderaciones del score (se normalizan automáticamente) ---
WEIGHT_SKILLS=0.45
WEIGHT_SEMANTIC=0.20
WEIGHT_EXPERIENCE=0.15
WEIGHT_EDUCATION=0.10
WEIGHT_LANGUAGES=0.10
